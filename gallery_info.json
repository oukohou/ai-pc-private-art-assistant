{
  "name": "AI PC端侧私密绘画助手",
  "name_en": "AI PC Private Art Assistant",
  "version": "1.0.0",
  "description": "基于OpenVINO的端侧AI绘画助手，实现Stable Diffusion模型的本地优化部署，支持CPU/GPU/NPU异构计算加速",
  "description_en": "Edge AI art assistant based on OpenVINO, featuring local Stable Diffusion deployment with heterogeneous computing acceleration",
